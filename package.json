{
	"name": "meditrack-app",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"emulators": "node local-testing/start-emulators.cjs",
		"test:local": "node local-testing/regression.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^7.0.1",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"firebase-admin": "^14.5.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.5"
	},
	"dependencies": {
		"firebase": "^12.19.0"
	},
	"overrides": {
		"@grpc/grpc-js": "^1.14.6"
	},
	"engines": {
		"node": ">=22.17.0 <23"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
